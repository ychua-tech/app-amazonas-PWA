# Copie este arquivo para server/.env e ajuste os valores.
# O server/.env NÃO vai pro git (está no .gitignore) — a senha real fica só lá.

# Porta do servidor (padrão 3333)
PORT=3333

# Senha do painel/admin — TROQUE por algo forte e único antes de publicar.
# É o único segredo que separa o admin do público.
ADMIN_TOKEN=troque-por-uma-senha-forte

# Chave Pix que o cliente recebe quando a loja confirma um pedido pago por Pix.
# Padrão: CNPJ da loja (definido em server/index.js). Só preencha pra trocar.
# PIX_TIPO: CNPJ | CPF | Celular | E-mail | Aleatória
# PIX_TIPO=CNPJ
# PIX_CHAVE=36901718000104
